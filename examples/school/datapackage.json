{
  "name": "school-example",
  "title": "Student grades (synthetic example)",
  "resources": [
    {
      "name": "students",
      "path": "students.csv",
      "format": "csv",
      "schema": {
        "fields": [
          {
            "name": "id",
            "type": "integer"
          },
          {
            "name": "name",
            "type": "string",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "active",
            "type": "boolean"
          }
        ],
        "primaryKey": "id"
      }
    },
    {
      "name": "grades",
      "path": "grades.csv",
      "format": "csv",
      "schema": {
        "fields": [
          {
            "name": "student_id",
            "type": "integer"
          },
          {
            "name": "score",
            "type": "number",
            "constraints": {
              "minimum": 0,
              "maximum": 100
            }
          }
        ],
        "foreignKeys": [
          {
            "fields": "student_id",
            "reference": {
              "resource": "students",
              "fields": "id"
            }
          }
        ]
      }
    }
  ]
}
