{
  "name": "shop-example",
  "title": "Shop catalog and orders",
  "resources": [
    {"name":"products","path":"products.csv","format":"csv","schema":{"fields":[{"name":"id","type":"integer"},{"name":"title","type":"string","constraints":{"required":true}}],"primaryKey":"id"}},
